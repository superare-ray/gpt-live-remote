CONTROL_API_BASE=https://example.com
BRIDGE_TOKEN_FILE=.bridge-token
BRIDGE_CONFIG_PATH=~/.gpt-live-remote/device.json
DEVICE_NAME=工作室 MacBook Pro
DEVICE_KIND=macbook
AUTO_APPROVE_PAIRING=false
CHATGPT_BUNDLE_ID=com.openai.codex
VOICE_SHORTCUT_KEY=v
VOICE_SHORTCUT_MODIFIERS=control,shift
# Optional local-only expression calibrated from `npm run diagnose` while Voice is active.
# VOICE_ACTIVE_AX_MATCH=AXIdentifier=.*voice
VOICE_STATE_TIMEOUT_MS=8000
PHONE_TO_CHATGPT_DEVICE=BlackHole 2ch
LOCAL_PLAYBACK_DEVICE=Mac mini扬声器
FFPLAY_PATH=/opt/homebrew/bin/ffplay
MEDIA_ONLY_MODE=false
